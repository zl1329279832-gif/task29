<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.visitor.mapper.VisitorMapper">

    <select id="findByPhone" resultType="com.visitor.model.entity.Visitor">
        SELECT * FROM visitor WHERE phone = #{phone} LIMIT 1
    </select>

    <select id="findByIdCard" resultType="com.visitor.model.entity.Visitor">
        SELECT * FROM visitor WHERE id_card = #{idCard} LIMIT 1
    </select>

</mapper>
